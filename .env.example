# ==========================================
# TrailGuard Unified Environment Configuration
# ==========================================

# -----------------
# 1. Backend Service
# -----------------
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/trailguard

# Security & Secrets
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
SESSION_SECRET=replace-with-a-secure-session-secret-key

# CORS Whitelist (comma-separated origins)
CLIENT_URLS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Twilio SMS / WhatsApp Alerts (Optional)
TWILIO_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -----------------
# 2. Frontend Web App
# -----------------
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# -----------------
# 3. Mobile Application
# -----------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# -----------------
# 4. Docker Compose Settings
# -----------------
MONGO_PORT=27017
BACKEND_PORT=3000
FRONTEND_PORT=80
