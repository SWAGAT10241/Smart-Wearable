# TrailGuard / SWAAS - Centralized Environment Configuration Template
# Duplicate this file to .env or inject values in your deployment environment.

# ==========================================
# 1. Backend Service Configuration (Node.js)
# ==========================================
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/trailguard

# Authentication & Sessions (Minimum 32 characters for production)
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_for_security
SESSION_SECRET=your_session_secret_must_be_at_least_32_characters_long

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Twilio SMS / WhatsApp Alerts (Optional in dev, required for live SOS dispatch)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google OAuth2 (Optional for SSO login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# 2. Frontend Web Dashboard (Vite / React)
# ==========================================
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/live

# ==========================================
# 3. Mobile Companion App (Expo / React Native)
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_WS_URL=ws://localhost:3000/live

# ==========================================
# 4. Docker Compose Orchestration
# ==========================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=trailguardsecret
MONGO_DB_NAME=trailguard
MONGODB_PORT=27017
BACKEND_PORT=3000
FRONTEND_PORT=80
