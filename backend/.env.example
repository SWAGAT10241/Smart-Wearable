# Server
PORT=3000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://localhost:3000

# Database (IBM Cloud Databases for MongoDB, or MongoDB Atlas, or local)
MONGODB_URI=mongodb://localhost:27017/trailguard
# Optional; use a dedicated least-privilege operator credential for provisioning.
DEVICE_PROVISIONING_MONGODB_URI=
# Ed25519 key used to sign short-lived device pairing/telemetry receipts.
# Generate with `pnpm generate-device-authority-keys` and store securely.
DEVICE_AUTHORITY_PRIVATE_KEY=

# Auth
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
SESSION_SECRET=replace_this_with_another_long_random_string_at_least_32_chars

# Google OAuth (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Twilio SMS / WhatsApp alerts for emergency contact
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

DEVICE_AUTH_ENABLED=true
DEVICE_MAX_CLOCK_SKEW_SECONDS=300

DEVICE_ID=TRAILGUARD-DEMO-001
DEVICE_KEY=test-device-secret-001