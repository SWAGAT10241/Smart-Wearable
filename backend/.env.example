# Server
PORT=3000
CLIENT_URL=http://localhost:5173

# Database (IBM Cloud Databases for MongoDB, or MongoDB Atlas, or local)
MONGODB_URI=mongodb://localhost:27017/trailguard

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
SESSION_SECRET=replace_this_with_another_long_random_string

# Google OAuth (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Optional: Twilio SMS alerts for emergency contact
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

DEVICE_AUTH_ENABLED=true
DEVICE_MAX_CLOCK_SKEW_SECONDS=300

DEVICE_ID=TRAILGUARD-DEMO-001
DEVICE_KEY=test-device-secret-001