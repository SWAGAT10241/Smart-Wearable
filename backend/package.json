{
  "name": "trailguard-backend",
  "version": "2.0.0",
  "description": "Backend server for TrailGuard - Smart Wearable Safety and Health Monitoring System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "simulate": "node simulate-esp32.js",
    "provision-device": "node scripts/provision-device.js",
    "generate-device-authority-keys": "node scripts/generate-device-authority-keys.js",
    "test": "jest --runInBand",
    "test:load": "k6 run ../scripts/load-test-k6.js",
    "test:max": "k6 run ../scripts/max-stress-k6.js",
    "pm2:start": "pm2 start ../ecosystem.config.cjs",
    "pm2:stop": "pm2 stop trailguard-backend",
    "pm2:restart": "pm2 restart trailguard-backend",
    "pm2:logs": "pm2 logs trailguard-backend"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.9.0",
    "mongoose": "^9.12.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "twilio": "^6.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "qs": ">=6.16.1",
    "ip-address": ">=10.7.4",
    "minimatch": ">=11.0.1"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
