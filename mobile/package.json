{
  "name": "trailguard-mobile",
  "version": "2.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check:syntax": "node scripts/check-syntax.js",
    "doctor": "npx expo-doctor",
    "export:check": "npx expo export -p android --no-bytecode",
    "check": "node scripts/check-syntax.js && npx expo-doctor"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.25",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-location",
        "expo-notifications"
      ]
    }
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
